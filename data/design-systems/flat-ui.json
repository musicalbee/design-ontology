{
  "$schema": "../../schema/design-system.schema.json",
  "id": "flat-ui",
  "name": "Flat UI (Designmodo)",
  "kind": "ui-kit",
  "owner": null,
  "people": [],
  "first_release": {
    "year": 2013,
    "circa": true
  },
  "licence": "MIT",
