{
  "$schema": "../../schema/design-system.schema.json",
  "id": "pico-css",
  "name": "Pico CSS",
  "kind": "ui-kit",
  "owner": null,
  "people": [],
  "first_release": {
    "year": 2019,
    "circa": true
  },
  "licence": "MIT",
  "url": "https://picocss.com/",
  "tokens": {
    "color": {
      "primary": "#0172ad",
      "bg": "#ffffff",
