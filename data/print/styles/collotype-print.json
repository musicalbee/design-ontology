  "region": "Paris, Munich, London",
  "summary": "A glass or metal plate is coated with light-hardened gelatin, which swells with water to take ink in proportion to tone. The print has continuous tone with only a fine reticulation, and is often a warm brown or black on matt paper.",
  "philosophy": {
    "core_thesis": "A light-hardened gelatin film that takes ink in proportion to tone prints a photograph with true continuous tone and no dot screen.",
    "design_principles": [
      "Expose a gelatin film under a negative, so that the hardened parts take ink and the soft parts take water.",
      "Print the film on a flat-bed press, damped and rolled up with ink before each sheet.",
      "Show the tone as a fine, random reticulation grain, finer than a halftone dot.",
      "Print in a brown-black or black monotone on matt paper; use more plates for a colour print.",
      "Keep the edition under 2,000 sheets; the gelatin wears and the black weakens.",
      "Print the picture with no plate mark and a clean margin."
    ],
    "anti_patterns": [
      "A regular halftone dot",
      "Glossy coated paper",
      "Saturated process colour",
      "A hard vector edge",
      "A plate mark or an emboss"
    ]
  },
  "vectors": {
    "tone_method": 5,
    "ink_layering": 2,
    "registration_play": 2,
    "surface_relief": 1,
    "hand_trace": 1
  },
  "process": {
    "family": "planographic",
    "matrix": "Gelatin-coated glass or zinc plate",
    "press": "Flat-bed lithographic or special collotype press",
    "image_making": "Gelatin exposed under a negative; wet; rolled up with ink",
    "edition": "Under 2,000 (the gelatin wears)"
  },
  "inks": {
    "strategy": "One black or brown-black ink; a colour print adds up to three transparent inks, each from its own gelatin plate.",
    "ink_count_min": 1,
    "ink_count_max": 4,
    "overprint": "transparent",
    "colours": [
