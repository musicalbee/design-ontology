{
  "$schema": "../../schema/principle.schema.json",
  "id": "negative-space",
  "name": "Negative space",
  "aliases": [
    "empty space",
    "void",
    "ma"
  ],
  "definition": "The empty area around and between elements. It is a part of the composition, not a remainder.",
  "measures": [
    {
      "measure": "empty floor area",
      "unit": "% of floor",
      "reference": "40–80 in a room",
      "domains": [
        "architecture",
        "interior"
      ]
    },
    {
      "measure": "empty wall area",
      "unit": "% of wall",
      "reference": "50–95",
      "domains": [
        "architecture",
        "interior"
      ]
    },
    {
      "measure": "empty frame area",
      "unit": "% of image",
      "reference": "30–70"
    }
  ],
  "applies_to": [
    "design",
    "architecture",
    "interior",
    "photography",
    "painting",
    "film"
  ],
  "related": [
    "balance",
    "focal-point",
    "unity-variety"
  ],
  "sources": [
    {
      "title": "Rudolf Arnheim, Art and Visual Perception: A Psychology of the Creative Eye (University of California Press, 1954; new version 1974)"
    },
    {
      "title": "Francis D. K. Ching, Architecture: Form, Space, and Order (Wiley, 4th edition, 2014)"
    }
  ]
}
