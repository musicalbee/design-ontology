{
  "$schema": "../../schema/principle.schema.json",
  "id": "lighting-layers",
  "name": "Lighting layers",
  "aliases": [
    "layered light",
    "key and fill"
  ],
  "definition": "Light comes from separate layers with separate jobs: ambient light for the whole space, task light for work, accent light for the focal point. In photography the same split is key, fill and accent light.",
  "measures": [
    {
      "measure": "ambient illuminance",
      "unit": "lux",
      "reference": "50–300 in a home",
      "domains": [
        "architecture",
        "interior"
      ]
    },
    {
      "measure": "task illuminance",
      "unit": "lux",
      "reference": "300–750",
      "domains": [
        "architecture",
        "interior"
      ]
    },
    {
      "measure": "accent to ambient",
      "unit": "ratio",
      "reference": "3:1 to 10:1",
      "domains": [
        "interior",
        "architecture",
        "photography",
        "painting"
      ]
    },
    {
      "measure": "correlated colour temperature",
      "unit": "kelvin",
      "reference": "2200–4000 in a home",
      "domains": [
        "architecture",
        "interior"
      ]
    },
    {
      "measure": "key to fill",
      "unit": "ratio",
      "reference": "2:1 to 8:1 in photography",
      "domains": [
        "photography"
      ]
    },
    {
      "measure": "key to fill",
      "unit": "ratio",
      "reference": "2:1 flat and natural; 4:1 glamour; 8:1 or more for deep shadow",
      "domains": [
        "film"
      ]
    }
  ],
  "applies_to": [
    "interior",
    "architecture",
    "photography",
    "painting",
    "film"
  ],
  "related": [
    "contrast",
    "focal-point"
  ],
  "sources": [
    {
      "title": "IES Lighting Handbook, 10th edition (Illuminating Engineering Society, 2011)"
    },
    {
      "title": "EN 12464-1:2021, Light and lighting. Lighting of work places. Indoor work places"
    }
  ]
}
