{
  "$schema": "../../schema/principle.schema.json",
  "id": "unity-variety",
  "name": "Unity and variety",
  "aliases": [
    "harmony",
    "coherence"
  ],
  "definition": "Repeated materials, colours and shapes join the parts into one whole. A small, planned number of deviations keeps the whole alive.",
  "measures": [
    {
      "measure": "materials or hues that repeat",
      "unit": "count",
      "reference": "2 to 4"
    },
    {
      "measure": "deliberate deviations",
      "unit": "count",
      "reference": "1 to 2"
    }
  ],
  "applies_to": [
    "design",
    "architecture",
    "interior",
    "photography",
    "painting",
    "film"
  ],
  "related": [
    "rhythm",
    "contrast"
  ],
  "sources": [
    {
      "title": "Donis A. Dondis, A Primer of Visual Literacy (MIT Press, 1973)"
    }
  ]
}
