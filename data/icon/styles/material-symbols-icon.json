  },
  "region": "Google, Material Design",
  "formats": [
    "svg",
    "png",
    "icon font",
    "variable icon font"
  ],
  "summary": "Google's open icon system: geometric glyphs on a 24 dp grid with keyline shapes. Material Icons (2014) gave five themes; Material Symbols (2022) is a variable font with axes for fill, weight, grade and optical size.",
  "philosophy": {
    "core_thesis": "An icon system is a set of tokens: one grid and four variable axes let one glyph serve every size, weight and state.",
    "design_principles": [
      "Draw on a 24 × 24 dp grid with a live area of 20 × 20 dp and 2 dp of padding.",
      "Fit each glyph to a keyline: a circle of 20 dp, a square of 18 dp, a portrait rectangle of 16 × 20 dp or a landscape rectangle of 20 × 16 dp.",
      "Set the stroke at 2 dp for weight 400, from 100 to 700 on the weight axis.",
      "Use the fill axis (0 or 1) for state: outline for inactive, filled for active.",
      "Set the optical size axis to the render size (20, 24, 40 or 48 dp).",
      "Use a corner radius of 2 dp for the rounded style and 0 dp for the sharp style; the outlined style uses 0–1 dp."
    ],
    "anti_patterns": [
      "Glyphs off the keyline shapes",
      "Stroke weights that differ inside one screen",
      "Decorative colour inside a system glyph",
      "Perspective or 3D effects",
      "Fill state changes without meaning"
    ]
  },
  "vectors": {
    "realism": 1,
    "fill": 3,
    "corner_softness": 3,
    "detail_density": 1,
    "colour_count": 1
  },
  "grid": {
    "sizes_px": [
      20,
      24,
      40,
      48
    ],
    "base_px": 24,
    "live_area_px": 20,
    "padding_px": 2,
    "keylines": "Circle 20 dp, square 18 dp, portrait 16 × 20 dp, landscape 20 × 16 dp."
  },
  "stroke": {
    "width_px": 2,
    "caps": "butt",
    "joins": "miter",
    "rule": "2 dp at weight 400; outlined and sharp styles use butt caps and miter joins, the rounded style uses round caps and joins."
  },
  "shape": {
    "corner_radius_px": 2,
    "primitives": "Geometric primitives on the keylines; angles at 0°, 45° and 90°.",
    "optical_size": "The optical size axis thickens the stroke and opens counters at 20 dp, and thins it at 48 dp."
  },
  "colour": {
    "count_max": 1,
    "gradients": false,
    "strategy": "One colour from the theme: on-surface for default, primary for active.",
    "colours": [
      {
        "name": "On surface",
        "hex": "#1D1B20",
        "role": "default glyph"
      },
      {
