{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/architecture.schema.json",
  "title": "Architecture style",
  "description": "One architectural style. It shares identity, philosophy, lineage, emotion and agent routing with every other domain, and has its own vectors and facets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "domain", "name", "aliases", "era_id", "time_period", "building_types", "summary",
    "philosophy", "vectors", "massing", "structure", "materials", "facade",
    "light_and_space", "ornament", "lineage", "emotion", "agent", "primer"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "../core.schema.json#/$defs/slug" },
    "domain": { "const": "architecture" },
    "name": { "$ref": "../core.schema.json#/$defs/shortText" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "../core.schema.json#/$defs/shortText" }
    },
    "era_id": { "$ref": "../core.schema.json#/$defs/slug", "description": "An id from data/architecture/eras/." },
    "time_period": { "$ref": "../core.schema.json#/$defs/time_period" },
    "building_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["residential", "civic", "cultural", "commercial", "industrial", "religious", "landscape", "interior"] }
    },
    "summary": { "type": "string", "minLength": 40, "maxLength": 320 },
    "philosophy": { "$ref": "../core.schema.json#/$defs/philosophy" },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ornamentation", "structural_expression", "geometric_rigidity",
        "material_rawness", "monumentality"
      ],
      "properties": {
        "ornamentation": { "$ref": "../core.schema.json#/$defs/score", "description": "1 = no applied ornament, 5 = ornament covers the surface." },
        "structural_expression": { "$ref": "../core.schema.json#/$defs/score", "description": "1 = structure hidden behind cladding, 5 = structure is the image." },
        "geometric_rigidity": { "$ref": "../core.schema.json#/$defs/score", "description": "1 = organic / free-form, 5 = strict orthogonal module." },
        "material_rawness": { "$ref": "../core.schema.json#/$defs/score", "description": "1 = finished and coated, 5 = raw and unfinished." },
        "monumentality": { "$ref": "../core.schema.json#/$defs/score", "description": "1 = domestic human scale, 5 = monumental." }
      }
    },
    "massing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form", "proportion", "roof", "relation_to_ground"],
      "properties": {
        "form": { "$ref": "../core.schema.json#/$defs/sentence" },
        "proportion": { "$ref": "../core.schema.json#/$defs/sentence" },
        "roof": { "$ref": "../core.schema.json#/$defs/sentence" },
        "relation_to_ground": { "$ref": "../core.schema.json#/$defs/sentence" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "span_and_module", "expression"],
      "properties": {
        "system": { "$ref": "../core.schema.json#/$defs/sentence" },
        "span_and_module": { "$ref": "../core.schema.json#/$defs/sentence" },
        "expression": { "$ref": "../core.schema.json#/$defs/sentence" }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "finish", "palette"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "$ref": "../core.schema.json#/$defs/shortText" } },
        "secondary": { "type": "array", "items": { "$ref": "../core.schema.json#/$defs/shortText" } },
        "finish": { "$ref": "../core.schema.json#/$defs/sentence" },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hex", "role"],
            "properties": {
              "name": { "$ref": "../core.schema.json#/$defs/shortText" },
              "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
              "role": { "$ref": "../core.schema.json#/$defs/shortText" }
            }
          }
        }
      }
    },
    "facade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "openings", "solid_to_void"],
      "properties": {
        "composition": { "$ref": "../core.schema.json#/$defs/sentence" },
        "openings": { "$ref": "../core.schema.json#/$defs/sentence" },
        "solid_to_void": { "$ref": "../core.schema.json#/$defs/sentence", "description": "Give a ratio or a range." }
      }
    },
    "light_and_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daylight", "spatial_sequence", "interior_character"],
      "properties": {
        "daylight": { "$ref": "../core.schema.json#/$defs/sentence" },
        "spatial_sequence": { "$ref": "../core.schema.json#/$defs/sentence" },
        "interior_character": { "$ref": "../core.schema.json#/$defs/sentence" }
      }
    },
    "ornament": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attitude", "details"],
      "properties": {
        "attitude": { "$ref": "../core.schema.json#/$defs/sentence" },
        "details": { "type": "array", "minItems": 1, "items": { "$ref": "../core.schema.json#/$defs/shortText" } }
      }
    },
    "lineage": { "$ref": "../core.schema.json#/$defs/lineage" },
    "emotion": { "$ref": "../core.schema.json#/$defs/emotion" },
    "agent": { "$ref": "../core.schema.json#/$defs/agent" },
    "primer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "canonical_works"],
      "description": "The implementation layer for architecture: vocabulary for image, 3D and brief generation.",
      "properties": {
        "positive": { "type": "array", "minItems": 5, "maxItems": 16, "items": { "$ref": "../core.schema.json#/$defs/shortText" } },
        "negative": { "type": "array", "minItems": 3, "maxItems": 12, "items": { "$ref": "../core.schema.json#/$defs/shortText" } },
        "canonical_works": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["work", "architect", "year"],
            "properties": {
              "work": { "$ref": "../core.schema.json#/$defs/shortText" },
              "architect": { "$ref": "../core.schema.json#/$defs/shortText" },
              "year": { "type": "integer", "minimum": 1800, "maximum": 2100 }
            }
          }
        }
      }
    },
    "sources": { "$ref": "../core.schema.json#/$defs/sources" }
  }
}
