{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/icon.schema.json",
  "title": "Icon style",
  "description": "One icon style: a set of measurable rules for a glyph or a pictogram on a pixel grid. It shares identity, philosophy, lineage, emotion and agent routing with every other domain. Each style must give open-licence evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "name",
    "aliases",
    "era_id",
    "time_period",
    "region",
    "formats",
    "summary",
    "philosophy",
    "vectors",
    "grid",
    "stroke",
    "shape",
    "colour",
    "perspective_and_light",
    "metaphor",
    "prompt_primer",
    "evidence",
    "lineage",
    "emotion",
    "agent",
    "sources"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "px": {
      "type": "number",
      "minimum": 0,
      "maximum": 1024
    }
  },
  "properties": {
    "permutations": { "$ref": "../core.schema.json#/$defs/permutations" },
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "../core.schema.json#/$defs/slug"
    },
    "domain": {
      "const": "icon"
    },
    "name": {
      "$ref": "../core.schema.json#/$defs/shortText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core.schema.json#/$defs/shortText"
      }
    },
    "era_id": {
      "$ref": "../core.schema.json#/$defs/slug",
      "description": "An id from data/icon/eras/."
    },
    "time_period": {
      "$ref": "../core.schema.json#/$defs/time_period"
    },
    "region": {
      "$ref": "../core.schema.json#/$defs/shortText",
      "description": "Where the style began: a platform, a company or a project."
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bitmap",
          "svg",
          "png",
          "icon font",
          "variable icon font",
          "3d render"
        ]
      },
      "description": "The file formats that carry the style."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320
    },
    "philosophy": {
      "$ref": "../core.schema.json#/$defs/philosophy"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realism",
        "fill",
        "corner_softness",
        "detail_density",
        "colour_count"
      ],
      "properties": {
        "realism": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = abstract glyph, 5 = rendered object with material and light."
        },
        "fill": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = stroke only, 5 = solid fill only."
        },
        "corner_softness": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = square, sharp corners, 5 = round, soft corners."
        },
        "detail_density": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = one idea in few strokes, 5 = many parts, texture and highlights."
        },
        "colour_count": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = one colour, 5 = full colour with gradients."
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sizes_px",
        "base_px",
        "live_area_px",
        "padding_px",
        "keylines"
      ],
      "description": "The pixel grid. All values are in px on the base grid.",
      "properties": {
        "sizes_px": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 8,
            "maximum": 1024
          },
          "description": "The sizes at which the set is drawn or hinted."
        },
        "base_px": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1024,
          "description": "The grid on which the master is drawn."
        },
        "live_area_px": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024,
          "description": "The side of the square that holds the drawing."
        },
        "padding_px": {
          "$ref": "#/$defs/px",
          "description": "The empty margin on each side, outside the live area."
        },
        "keylines": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The keyline shapes (square, circle, portrait, landscape) with their sizes."
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "caps",
        "joins",
        "rule"
      ],
      "properties": {
        "width_px": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 64,
          "description": "The stroke width on the base grid. null = the style has no stroke."
        },
        "caps": {
          "enum": [
            "round",
            "butt",
            "square",
            "none"
          ],
          "description": "The terminal caps of open paths."
        },
        "joins": {
          "enum": [
            "round",
            "miter",
            "bevel",
            "none"
          ]
        },
        "rule": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corner_radius_px",
        "primitives",
        "optical_size"
      ],
      "properties": {
        "corner_radius_px": {
          "$ref": "#/$defs/px",
          "description": "The outer corner radius of a square shape on the base grid. 0 = sharp."
        },
        "primitives": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The basic shapes and the angles that are allowed."
        },
        "optical_size": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How the drawing changes from the smallest to the largest size."
        }
      }
    },
    "colour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_max",
        "gradients",
        "strategy",
        "colours"
      ],
      "properties": {
        "count_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "description": "The maximum number of flat colours in one icon. A gradient counts as its stops."
        },
        "gradients": {
          "type": "boolean"
        },
        "strategy": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "colours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex",
              "role"
            ],
            "properties": {
              "name": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "hex": {
                "$ref": "#/$defs/hex"
              },
              "role": {
                "$ref": "../core.schema.json#/$defs/shortText"
              }
            }
          }
        }
      }
    },
    "perspective_and_light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "light",
        "shadow"
      ],
      "properties": {
        "view": {
          "enum": [
            "front orthographic",
            "isometric",
            "three-quarter perspective",
            "top-down"
          ]
        },
        "light": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "shadow": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "metaphor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typical",
        "treatment"
      ],
      "properties": {
        "typical": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The objects that the set draws."
        },
        "treatment": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How an idea becomes an object: literal, reduced or symbolic."
        }
      }
    },
    "prompt_primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "description": "The implementation layer: vocabulary for an image prompt or an art brief.",
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 6,
          "maxItems": 14,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        }
      }
    },
    "evidence": {
      "$ref": "../core.schema.json#/$defs/evidence",
      "description": "Required in this domain, with at least one item: an open-licence icon set or a Commons file that shows the style."
    },
    "lineage": {
      "$ref": "../core.schema.json#/$defs/lineage"
    },
    "emotion": {
      "$ref": "../core.schema.json#/$defs/emotion"
    },
    "agent": {
      "$ref": "../core.schema.json#/$defs/agent"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "../core.schema.json#/$defs/sources/items"
      }
    }
  }
}
