{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/photography.schema.json",
  "title": "Photography style",
  "description": "One photographic style: a set of rules for a camera and a light. It shares identity, philosophy, lineage, emotion and agent routing with every other domain, and has its own vectors and facets. Numbers are exact: millimetres, f-numbers, seconds, ISO, kelvin, ratios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "name",
    "aliases",
    "era_id",
    "time_period",
    "process",
    "summary",
    "philosophy",
    "vectors",
    "composition",
    "light",
    "lens_and_camera",
    "colour_and_grade",
    "subject_and_staging",
    "post_processing",
    "prompt_primer",
    "lineage",
    "emotion",
    "agent",
    "sources"
  ],
  "$defs": {
    "spec": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "description": "A short value with its unit, for example \"50mm (35mm format)\" or \"f/8 to f/11\"."
    }
  },
  "properties": {
    "permutations": { "$ref": "../core.schema.json#/$defs/permutations" },
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "../core.schema.json#/$defs/slug"
    },
    "domain": {
      "const": "photography"
    },
    "name": {
      "$ref": "../core.schema.json#/$defs/shortText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core.schema.json#/$defs/shortText"
      }
    },
    "era_id": {
      "$ref": "../core.schema.json#/$defs/slug",
      "description": "An id from data/photography/eras/."
    },
    "time_period": {
      "$ref": "../core.schema.json#/$defs/time_period"
    },
    "process": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "analogue-bw",
          "analogue-colour",
          "digital",
          "hybrid"
        ]
      },
      "description": "The medium the style was made in. A style can move between media."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320
    },
    "philosophy": {
      "$ref": "../core.schema.json#/$defs/philosophy"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging",
        "tonal_contrast",
        "colour_saturation",
        "depth_of_field",
        "proximity"
      ],
      "properties": {
        "staging": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = found, unplanned. 5 = fully constructed."
        },
        "tonal_contrast": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = flat, narrow range. 5 = hard, black to white."
        },
        "colour_saturation": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = monochrome or muted. 5 = saturated."
        },
        "depth_of_field": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = deep, all sharp. 5 = shallow, subject isolated."
        },
        "proximity": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = distant, context first. 5 = intimate, close to the subject."
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "viewpoint",
        "geometry",
        "subject_placement",
        "principles"
      ],
      "properties": {
        "framing": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "viewpoint": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "geometry": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "subject_placement": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "principles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principle",
              "rule"
            ],
            "properties": {
              "principle": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "An id from data/principles/ (issue #7)."
              },
              "rule": {
                "$ref": "../core.schema.json#/$defs/sentence",
                "description": "How this style applies the principle, with its own number."
              }
            }
          }
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "direction",
        "key_to_fill_ratio",
        "colour_temperature"
      ],
      "properties": {
        "quality": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "direction": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "key_to_fill_ratio": {
          "$ref": "#/$defs/spec",
          "description": "A ratio such as \"3:1 (1.6 stops)\"."
        },
        "colour_temperature": {
          "$ref": "#/$defs/spec",
          "description": "Kelvin, for the light on the subject."
        },
        "time_of_day": {
          "$ref": "../core.schema.json#/$defs/shortText"
        }
      }
    },
    "lens_and_camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "focal_length",
        "aperture",
        "shutter",
        "film_speed",
        "focus"
      ],
      "properties": {
        "format": {
          "$ref": "#/$defs/spec"
        },
        "focal_length": {
          "$ref": "#/$defs/spec",
          "description": "Value in millimetres. Give the 35mm-format equivalent when the format differs."
        },
        "aperture": {
          "$ref": "#/$defs/spec"
        },
        "shutter": {
          "$ref": "#/$defs/spec"
        },
        "film_speed": {
          "$ref": "#/$defs/spec"
        },
        "focus": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "support": {
          "$ref": "../core.schema.json#/$defs/shortText"
        },
        "equipment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "maxItems": 6,
          "uniqueItems": true
        }
      }
    },
    "colour_and_grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "palette",
        "grade_recipe",
        "grain"
      ],
      "properties": {
        "treatment": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex",
              "role"
            ],
            "properties": {
              "name": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "role": {
                "$ref": "../core.schema.json#/$defs/shortText"
              }
            }
          }
        },
        "grade_recipe": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "$ref": "../core.schema.json#/$defs/sentence"
          },
          "description": "Ordered steps with numbers: black point, white point, curve, saturation, hue shifts, split-toning, grain."
        },
        "grain": {
          "$ref": "#/$defs/spec"
        }
      }
    },
    "subject_and_staging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "staging",
        "direction"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "staging": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "direction": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "post_processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "output"
      ],
      "properties": {
        "workflow": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/sentence"
          }
        },
        "output": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "prompt_primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "canonical_works"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "maxItems": 16
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "maxItems": 12
        },
        "canonical_works": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work",
              "maker",
              "year"
            ],
            "properties": {
              "work": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "maker": {
                "$ref": "../core.schema.json#/$defs/shortText",
                "description": "A photographer, a director or a camera maker."
              },
              "year": {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2100
              }
            }
          }
        }
      }
    },
    "evidence": { "$ref": "../core.schema.json#/$defs/evidence" },
    "lineage": {
      "$ref": "../core.schema.json#/$defs/lineage"
    },
    "emotion": {
      "$ref": "../core.schema.json#/$defs/emotion"
    },
    "agent": {
      "$ref": "../core.schema.json#/$defs/agent"
    },
    "sources": {
      "$ref": "../core.schema.json#/$defs/sources"
    }
  }
}
