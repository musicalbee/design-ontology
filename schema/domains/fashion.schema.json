{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/fashion.schema.json",
  "title": "Fashion style",
  "description": "One fashion style: the rules of one branch (costume, outdoor, underwear, shoes, accessories, jewellery, watch or cars) in one period. Silhouette, fabrics, construction, surface, palette and making, with three to six signature pieces. Fabric, material, finish and object ids come from data/fashion/vocabulary.json; the validator checks each one. Prompts never name a brand or a product: the names appear only in canonical_works and sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "name",
    "aliases",
    "era_id",
    "branch",
    "time_period",
    "region",
    "summary",
    "philosophy",
    "vectors",
    "silhouette",
    "fabrics",
    "construction",
    "surface",
    "palette",
    "making",
    "signatures",
    "prompt_primer",
    "evidence",
    "lineage",
    "emotion",
    "agent",
    "sources"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "branch": {
      "enum": [
        "costume",
        "outdoor",
        "underwear",
        "shoes",
        "accessories",
        "jewellery",
        "watch",
        "cars"
      ]
    }
  },
  "properties": {
    "permutations": {
      "$ref": "../core.schema.json#/$defs/permutations"
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "../core.schema.json#/$defs/slug"
    },
    "domain": {
      "const": "fashion"
    },
    "name": {
      "$ref": "../core.schema.json#/$defs/shortText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core.schema.json#/$defs/shortText"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "aat": {
          "type": "string",
          "pattern": "^3[0-9]{8}$"
        }
      },
      "description": "Open identifiers for the style. Store an id only when the record exists and matches the style."
    },
    "era_id": {
      "$ref": "../core.schema.json#/$defs/slug",
      "description": "An id from data/fashion/eras/."
    },
    "branch": {
      "$ref": "#/$defs/branch",
      "description": "The one branch of the style. Its signature pieces are objects of this branch."
    },
    "time_period": {
      "$ref": "../core.schema.json#/$defs/time_period"
    },
    "region": {
      "$ref": "../core.schema.json#/$defs/shortText",
      "description": "Where the style began or is centred."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320
    },
    "philosophy": {
      "$ref": "../core.schema.json#/$defs/philosophy"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ornamentation",
        "structure",
        "luxury",
        "technicality",
        "chromatic_intensity"
      ],
      "properties": {
        "ornamentation": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = plain cloth and clean lines, 5 = embroidery, beads, carving or brightwork on every part."
        },
        "structure": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = soft, draped, follows the body, 5 = rigid, built, holds its own shape."
        },
        "luxury": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = utility and everyday materials, 5 = precious materials and hand work."
        },
        "technicality": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = traditional craft and natural materials, 5 = engineered performance and new materials."
        },
        "chromatic_intensity": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = natural, neutral or black and white, 5 = saturated colour and bold pattern."
        }
      }
    },
    "silhouette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "line",
        "fit",
        "proportion",
        "rules"
      ],
      "properties": {
        "shape": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The outline of the body, the piece or the car body."
        },
        "line": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The main line: the waist, the shoulder, the hem, the case edge or the belt line of the body."
        },
        "fit": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How the piece sits on the body or on the road: ease, closeness, stance."
        },
        "proportion": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Ratios with numbers: hem height, lapel width, heel height, case diameter, wheelbase."
        },
        "rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/sentence"
          }
        }
      }
    },
    "fabrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "avoid",
        "rule"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Fabric or material ids from the vocabulary: the main surfaces of the style."
        },
        "secondary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Fabric or material ids for linings, trims and small parts."
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Fabric or material ids that break the style."
        },
        "rule": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "closures",
        "details"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "description": "The cut, the seams, the welt, the setting or the body build."
        },
        "closures": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Buttons, laces, hooks, zips, clasps, buckles or the doors and catches of a car."
        },
        "details": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The small marks of the style: the pocket, the collar, the brogue, the bezel, the badge."
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finishes",
        "pattern",
        "gloss",
        "wear"
      ],
      "properties": {
        "finishes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Finish ids from the vocabulary."
        },
        "pattern": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The print, the weave pattern, the stone setting or the paint scheme."
        },
        "gloss": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The gloss in GU of the main surfaces."
        },
        "wear": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How the surface ages, and if the style wants that patina."
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "colours"
      ],
      "properties": {
        "strategy": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "colours": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex",
              "role"
            ],
            "properties": {
              "name": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "hex": {
                "$ref": "#/$defs/hex"
              },
              "role": {
                "$ref": "../core.schema.json#/$defs/shortText"
              }
            }
          }
        }
      }
    },
    "making": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processes",
        "scale",
        "signs"
      ],
      "properties": {
        "processes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "scale": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Bespoke, couture, ready-to-wear, mass production or a coachbuilt series."
        },
        "signs": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "What shows how the piece was made."
        }
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pieces"
      ],
      "properties": {
        "pieces": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object",
              "form",
              "material",
              "finish"
            ],
            "properties": {
              "object": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "An object id of the branch of the style."
              },
              "form": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "material": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "A fabric or material id of the style (primary or secondary)."
              },
              "finish": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "A finish id whose families include the family of the material."
              }
            }
          }
        }
      }
    },
    "prompt_primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "canonical_works"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 6,
          "maxItems": 14,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "canonical_works": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work",
              "maker",
              "year"
            ],
            "properties": {
              "work": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "maker": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "year": {
                "type": "integer",
                "minimum": 1700,
                "maximum": 2100
              }
            }
          },
          "description": "Reference objects, for study only. Prompts never name them."
        }
      },
      "description": "Vocabulary for an image prompt or a product brief. It describes form, material and finish, never a brand or a product name."
    },
    "evidence": {
      "$ref": "../core.schema.json#/$defs/evidence",
      "description": "Open-licence or public-domain images of period objects."
    },
    "lineage": {
      "$ref": "../core.schema.json#/$defs/lineage"
    },
    "emotion": {
      "$ref": "../core.schema.json#/$defs/emotion"
    },
    "agent": {
      "$ref": "../core.schema.json#/$defs/agent"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "../core.schema.json#/$defs/sources/items"
      }
    }
  }
}
