{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/cuisine.schema.json",
  "title": "Cuisine style",
  "description": "One cuisine style: the rules of one kitchen (the haute and restaurant kitchen, a codified home tradition, pastry, bread, preservation, street food, a kitchen of diet and belief, or drink) in one period. Plating, pantry, technique, flavour, palette and service, with three to six signature dishes. Ingredient, method and course ids come from data/cuisine/vocabulary.json; the validator checks each one. Prompts never name a restaurant or a chef: the names appear only in canonical_works and sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "name",
    "aliases",
    "era_id",
    "branch",
    "time_period",
    "region",
    "summary",
    "philosophy",
    "vectors",
    "plating",
    "pantry",
    "technique",
    "flavour",
    "palette",
    "service",
    "signatures",
    "prompt_primer",
    "evidence",
    "lineage",
    "emotion",
    "agent",
    "sources"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "branch": {
      "enum": [
        "haute",
        "home",
        "pastry",
        "bread",
        "preservation",
        "street",
        "belief",
        "drink"
      ]
    }
  },
  "properties": {
    "permutations": {
      "$ref": "../core.schema.json#/$defs/permutations"
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "../core.schema.json#/$defs/slug"
    },
    "domain": {
      "const": "cuisine"
    },
    "name": {
      "$ref": "../core.schema.json#/$defs/shortText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core.schema.json#/$defs/shortText"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "aat": {
          "type": "string",
          "pattern": "^3[0-9]{8}$"
        }
      },
      "description": "Open identifiers for the style. Store an id only when the record exists and matches the style."
    },
    "era_id": {
      "$ref": "../core.schema.json#/$defs/slug",
      "description": "An id from data/cuisine/eras/."
    },
    "branch": {
      "$ref": "#/$defs/branch",
      "description": "The one branch of the style. Its signature dishes are of courses that list this branch."
    },
    "time_period": {
      "$ref": "../core.schema.json#/$defs/time_period"
    },
    "region": {
      "$ref": "../core.schema.json#/$defs/shortText",
      "description": "Where the style began or is centred."
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320
    },
    "philosophy": {
      "$ref": "../core.schema.json#/$defs/philosophy"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "transformation",
        "locality",
        "richness",
        "flavour_intensity"
      ],
      "properties": {
        "composition": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = heaped, shared and family-style, 5 = an architectural plate with exact placement and empty space."
        },
        "transformation": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = raw or plainly cooked, the ingredient as it grew, 5 = technique changes the form, the texture and the temperature."
        },
        "locality": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = a global pantry of imported goods, 5 = one place and one season, grown or foraged near the kitchen."
        },
        "richness": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = broth, acid, raw and steamed, 5 = butter, cream, fat and reduction."
        },
        "flavour_intensity": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = mild, clean and subtle, 5 = loud spice, chilli, smoke and ferment."
        }
      }
    },
    "plating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "plate",
        "portion",
        "height",
        "rules"
      ],
      "properties": {
        "composition": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How the food sits on the plate or the table: heaped, shared, in rows, in a ring, scattered or built up."
        },
        "plate": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The plate, the bowl or the vessel: its form, its size in mm and its material."
        },
        "portion": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The size of one serving with numbers: grams, the number of pieces, the share of the plate."
        },
        "height": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The height and the depth of the food on the plate in mm, and how the sauce sits."
        },
        "rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/sentence"
          }
        }
      }
    },
    "pantry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "avoid",
        "in_europe",
        "rule"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Ingredient ids from the vocabulary: the main ingredients of the style."
        },
        "secondary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Ingredient ids for garnish, seasoning and small parts."
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Ingredient ids that break the style."
        },
        "in_europe": {
          "type": "boolean",
          "description": "True when the kitchen of the style is in Europe. Then each ingredient of primary and secondary must have reached Europe (the arrival year of the vocabulary) by the start of the style."
        },
        "rule": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "technique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "bases",
        "details"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "../core.schema.json#/$defs/slug"
          },
          "description": "Method ids from the vocabulary: the cooking and preparation methods of the style."
        },
        "bases": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The stocks, sauces, doughs, ferments or spice bases that the kitchen keeps ready."
        },
        "details": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The small marks of the style: a cut, a glaze, a garnish, a fold, a char."
        }
      }
    },
    "flavour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "balance",
        "fat",
        "seasoning"
      ],
      "properties": {
        "profile": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The main tastes and aromas of the style."
        },
        "balance": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How salt, sweet, sour, bitter and umami sit against each other."
        },
        "fat": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The fat of the style and its share, with numbers where known."
        },
        "seasoning": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The salt, the spices, the herbs and the acids, and when the cook adds them."
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "colours"
      ],
      "properties": {
        "strategy": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "colours": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex",
              "role"
            ],
            "properties": {
              "name": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "hex": {
                "$ref": "#/$defs/hex"
              },
              "role": {
                "$ref": "../core.schema.json#/$defs/shortText"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "courses",
        "tableware",
        "setting"
      ],
      "properties": {
        "format": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How the food reaches the eater: service à la française, à la russe, a tasting menu, a counter, a stall, a shared table."
        },
        "courses": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The order and the number of courses or dishes, with numbers."
        },
        "tableware": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The plates, the glasses, the cutlery or the chopsticks, the linen and the vessels."
        },
        "setting": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The room, the kitchen and the people who cook and serve."
        }
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dishes"
      ],
      "properties": {
        "dishes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "course",
              "dish",
              "ingredient",
              "method"
            ],
            "properties": {
              "course": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "A course id of the vocabulary that lists the branch of the style."
              },
              "dish": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "ingredient": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "The main ingredient: an id in pantry.primary or pantry.secondary."
              },
              "method": {
                "$ref": "../core.schema.json#/$defs/slug",
                "description": "The main method: an id in technique.methods."
              }
            }
          }
        }
      }
    },
    "prompt_primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "canonical_works"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 6,
          "maxItems": 14,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "negative": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        },
        "canonical_works": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "work",
              "maker",
              "year"
            ],
            "properties": {
              "work": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "maker": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "year": {
                "type": "integer",
                "minimum": 1200,
                "maximum": 2100
              }
            }
          },
          "description": "Reference dishes, books and menus, for study only. Prompts never name them."
        }
      },
      "description": "Vocabulary for an image prompt or a product brief. It describes form, material and finish, never a brand or a product name."
    },
    "evidence": {
      "$ref": "../core.schema.json#/$defs/evidence",
      "description": "Open-licence or public-domain images and documents: a cookbook scan, a menu, a photograph of a dish or a kitchen."
    },
    "lineage": {
      "$ref": "../core.schema.json#/$defs/lineage"
    },
    "emotion": {
      "$ref": "../core.schema.json#/$defs/emotion"
    },
    "agent": {
      "$ref": "../core.schema.json#/$defs/agent"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "../core.schema.json#/$defs/sources/items"
      }
    }
  }
}
