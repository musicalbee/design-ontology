{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/domains/internet.schema.json",
  "title": "Design style (graphic and UI)",
  "description": "One graphic design or digital/UI design style. Every field is required unless marked optional: an agent cannot execute a style that has holes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "name",
    "aliases",
    "era_id",
    "time_period",
    "primary_mediums",
    "summary",
    "philosophy",
    "vectors",
    "layout",
    "typography",
    "color",
    "materiality",
    "ornamentation_details",
    "motion",
    "lineage",
    "emotion",
    "agent",
    "visual",
    "tokens"
  ],
  "properties": {
    "permutations": { "$ref": "../core.schema.json#/$defs/permutations" },
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "../core.schema.json#/$defs/slug"
    },
    "domain": {
      "const": "internet"
    },
    "name": {
      "$ref": "../core.schema.json#/$defs/shortText"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../core.schema.json#/$defs/shortText"
      }
    },
    "era_id": {
      "$ref": "../core.schema.json#/$defs/slug",
      "description": "An id from data/internet/eras/."
    },
    "time_period": {
      "$ref": "../core.schema.json#/$defs/time_period"
    },
    "primary_mediums": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "print",
          "web",
          "mobile",
          "spatial"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 320,
      "description": "Two sentences at most. What it looks like, and where it came from."
    },
    "philosophy": {
      "$ref": "../core.schema.json#/$defs/philosophy"
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ornamentation",
        "dimensionality",
        "grid_rigidity",
        "skeuomorphic_realism",
        "typographic_expressiveness"
      ],
      "properties": {
        "ornamentation": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = pure minimal, 5 = maximalist."
        },
        "dimensionality": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = strictly 2D, 5 = full 3D / spatial."
        },
        "grid_rigidity": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = chaotic / organic, 5 = strict mathematical grid."
        },
        "skeuomorphic_realism": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = abstract digital, 5 = photorealistic material."
        },
        "typographic_expressiveness": {
          "$ref": "../core.schema.json#/$defs/score",
          "description": "1 = neutral / invisible, 5 = experimental / illustrative."
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_mechanics",
        "whitespace_ratio",
        "alignment_rules",
        "container_geometry"
      ],
      "properties": {
        "grid_mechanics": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Columns, gutters, baseline, modules. Give numbers."
        },
        "whitespace_ratio": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Share of empty space and the spacing scale."
        },
        "alignment_rules": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "container_geometry": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Shape, radius and proportion of cards, panels, buttons."
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifications",
        "font_pairings",
        "tracking",
        "leading",
        "hierarchy_rules"
      ],
      "properties": {
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          },
          "description": "Type classes: \"neo-grotesque sans\", \"geometric sans\", \"slab serif\"."
        },
        "font_pairings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "description": "Open-source fonts only (SIL OFL or Apache). Each must be on Google Fonts or Fontsource.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "display",
              "body"
            ],
            "properties": {
              "display": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "body": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "note": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "tracking": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Letter-spacing in em, for display and for body."
        },
        "leading": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Line-height as unitless numbers."
        },
        "hierarchy_rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "../core.schema.json#/$defs/sentence"
          }
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette_structure",
        "palette",
        "contrast_rules",
        "surface_treatment",
        "light_and_shadow"
      ],
      "properties": {
        "palette_structure": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "How many hues, in what proportion."
        },
        "palette": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hex",
              "role"
            ],
            "properties": {
              "name": {
                "$ref": "../core.schema.json#/$defs/shortText"
              },
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$",
                "description": "Upper-case, six digits."
              },
              "role": {
                "$ref": "../core.schema.json#/$defs/shortText"
              }
            }
          }
        },
        "contrast_rules": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Give WCAG ratios where the style allows."
        },
        "surface_treatment": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "light_and_shadow": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Light direction, shadow type, or their absence."
        }
      }
    },
    "materiality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_simulation",
        "border_rules",
        "blur_and_elevation"
      ],
      "properties": {
        "surface_simulation": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "The physical material the surfaces imitate, or \"none\" with the reason."
        },
        "border_rules": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Width, colour, style in px."
        },
        "blur_and_elevation": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Blur radius, shadow offsets, elevation levels in px."
        }
      }
    },
    "ornamentation_details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iconography",
        "illustration",
        "decorative_elements"
      ],
      "properties": {
        "iconography": {
          "$ref": "../core.schema.json#/$defs/sentence",
          "description": "Stroke width, corner style, fill or outline."
        },
        "illustration": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "decorative_elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "../core.schema.json#/$defs/shortText"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "transition_physics",
        "easing",
        "duration_ms",
        "hover_and_active"
      ],
      "properties": {
        "native": {
          "type": "boolean",
          "description": "true = the style was born on screen and has its own motion language. false = a print style; the fields give a faithful translation for screen."
        },
        "transition_physics": {
          "$ref": "../core.schema.json#/$defs/sentence"
        },
        "easing": {
          "type": "string",
          "pattern": "^(linear|steps\\(.+\\)|cubic-bezier\\(.+\\))$",
          "description": "A valid CSS easing function."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "hover_and_active": {
          "$ref": "../core.schema.json#/$defs/sentence"
        }
      }
    },
    "evidence": {
      "$ref": "../core.schema.json#/$defs/evidence"
    },
    "lineage": {
      "$ref": "../core.schema.json#/$defs/lineage"
    },
    "emotion": {
      "$ref": "../core.schema.json#/$defs/emotion"
    },
    "agent": {
      "$ref": "../core.schema.json#/$defs/agent"
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "description": "The visual pack: how type, icons, pictures and page structure look. The compiler turns it into type tokens, an icon sprite, a hero plate and a pattern tile.",
      "required": [
        "type",
        "icon",
        "art",
        "layout",
        "ground"
      ],
      "properties": {
        "type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_weight",
            "display_tracking",
            "display_leading",
            "display_case",
            "body_leading",
            "body_size",
            "subhead_weight",
            "body_weight",
            "strong_weight",
            "label_weight",
            "accent"
          ],
          "properties": {
            "display_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "description": "A weight that the first display font has."
            },
            "display_tracking": {
              "type": "string",
              "pattern": "^-?\\d*\\.?\\d+em$"
            },
            "display_leading": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1.6
            },
            "display_case": {
              "enum": [
                "none",
                "uppercase",
                "lowercase"
              ]
            },
            "body_leading": {
              "type": "number",
              "minimum": 1.2,
              "maximum": 2
            },
            "body_size": {
              "type": "string",
              "pattern": "^\\d{2}px$"
            },
            "subhead_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "multipleOf": 100,
              "description": "Weight of a secondary heading, in the display face. The face must have this weight."
            },
            "body_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "multipleOf": 100,
              "description": "Weight of running text, in the text face."
            },
            "strong_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "multipleOf": 100,
              "description": "Weight of a bold word inside running text."
            },
            "label_weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900,
              "multipleOf": 100,
              "description": "Weight of a button, a label and a navigation item."
            },
            "accent": {
              "enum": [
                "weight",
                "size",
                "case",
                "colour"
              ],
              "description": "Where the style puts its emphasis. A style that accents by size, case or colour keeps few weights and a small step between them."
            }
          }
        },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "stroke_width",
            "linecap",
            "linejoin",
            "container",
            "pack"
          ],
          "properties": {
            "mode": {
              "enum": [
                "outline",
                "solid",
                "duotone"
              ]
            },
            "stroke_width": {
              "type": "number",
              "minimum": 1,
              "maximum": 4,
              "description": "On a 24px field."
            },
            "linecap": {
              "enum": [
                "butt",
                "round",
                "square"
              ]
            },
            "linejoin": {
              "enum": [
                "miter",
                "round",
                "bevel"
              ]
            },
            "container": {
              "enum": [
                "none",
                "circle",
                "rounded",
                "square"
              ],
              "description": "The tile behind an icon."
            },
            "pack": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "why"
              ],
              "description": "The open-source icon family that stands in for this style in the demo, and the reason for the choice. The id names a file in icons/packs/.",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "why": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          }
        },
        "art": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipe",
            "pattern",
            "seed"
          ],
          "properties": {
            "recipe": {
              "$ref": "../core.schema.json#/$defs/slug",
              "description": "A hero plate recipe in scripts/pack.ts. The validator checks that it exists."
            },
            "pattern": {
              "enum": [
                "none",
                "grid",
                "dots",
                "diagonal",
                "waves",
                "squiggle",
                "checks",
                "noise",
                "starburst"
              ]
            },
            "seed": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hero",
            "align",
            "density",
            "tilt_deg"
          ],
          "properties": {
            "hero": {
              "enum": [
                "split",
                "stacked",
                "poster"
              ],
              "description": "split = text beside picture. stacked = text above picture. poster = text on the picture."
            },
            "align": {
              "enum": [
                "left",
                "center"
              ]
            },
            "density": {
              "enum": [
                "compact",
                "regular",
                "airy"
              ]
            },
            "tilt_deg": {
              "type": "number",
              "minimum": -4,
              "maximum": 4,
              "description": "The rotation of accent elements. 0 for a style with a strict grid."
            }
          }
        },
        "ground": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "why"
          ],
          "description": "The ground behind the first screen of a page. The compiler writes it as the --ground token: a stack of gradients that reads the colour tokens of the style.",
          "properties": {
            "kind": {
              "$ref": "../core.schema.json#/$defs/slug",
              "description": "A ground recipe in scripts/ground.ts. The validator checks that it exists."
            },
            "why": {
              "$ref": "../core.schema.json#/$defs/sentence",
              "description": "The source of the ground in the history or the materials of the style."
            }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "css",
        "tailwind"
      ],
      "properties": {
        "css": {
          "type": "object",
          "description": "CSS custom properties. The required set is the contract every style fills, so an agent can swap one style for another.",
          "required": [
            "--color-bg",
            "--color-surface",
            "--color-text",
            "--color-muted",
            "--color-primary",
            "--color-accent",
            "--color-border",
            "--font-sans",
            "--font-display",
            "--border-radius",
            "--border-width",
            "--shadow-elevation",
            "--backdrop-filter",
            "--space-unit",
            "--ease",
            "--duration"
          ],
          "propertyNames": {
            "pattern": "^--[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "tailwind": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "description": "Tailwind utility patterns for common elements. Arbitrary values are allowed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "classes"
            ],
            "properties": {
              "element": {
                "$ref": "../core.schema.json#/$defs/shortText",
                "description": "\"page\", \"card\", \"button\", \"heading\", \"input\"."
              },
              "classes": {
                "type": "string",
                "minLength": 4,
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    "sources": {
      "$ref": "../core.schema.json#/$defs/sources"
    }
  }
}
