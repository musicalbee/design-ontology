{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/ceramics-vocabulary.schema.json",
  "title": "Ceramics vocabulary",
  "description": "The closed vocabulary of the ceramics domain, with the origin of each clay body, glaze and decoration. Styles refer to these ids, and the validator checks each reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branches",
    "bodies",
    "materials",
    "glazes",
    "decorations",
    "objects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "branches": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "order",
          "scope"
        ],
        "properties": {
          "id": {
            "enum": [
              "tableware",
              "teaware",
              "kitchen-and-storage",
              "vessels",
              "figurative",
              "tiles",
              "architectural",
              "sanitary-technical"
            ]
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "scope": {
            "$ref": "core.schema.json#/$defs/sentence"
          }
        }
      }
    },
    "bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "firing_c",
          "note"
        ],
        "properties": {
          "id": {
            "$ref": "core.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 2100
              },
              "circa": {
                "type": "boolean"
              },
              "place": {
                "$ref": "core.schema.json#/$defs/shortText"
              },
              "by": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "description": "Where and when the item began: the first year with a firm record."
          },
          "note": {
            "type": "string",
            "minLength": 12,
            "maxLength": 400
          },
          "kind": {
            "enum": [
              "earthenware",
              "stoneware",
              "porcelain",
              "frit"
            ]
          },
          "firing_c": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 500,
              "maximum": 1500
            },
            "description": "The usual maturing range of the body in degrees Celsius."
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "note"
        ],
        "properties": {
          "id": {
            "$ref": "core.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 2100
              },
              "circa": {
                "type": "boolean"
              },
              "place": {
                "$ref": "core.schema.json#/$defs/shortText"
              },
              "by": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "description": "Where and when the item began: the first year with a firm record."
          },
          "note": {
            "type": "string",
            "minLength": 12,
            "maxLength": 400
          },
          "kind": {
            "enum": [
              "metal",
              "wood",
              "glass",
              "plastic",
              "stone",
              "fibre",
              "other"
            ]
          }
        }
      }
    },
    "glazes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "bodies",
          "note"
        ],
        "properties": {
          "id": {
            "$ref": "core.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 2100
              },
              "circa": {
                "type": "boolean"
              },
              "place": {
                "$ref": "core.schema.json#/$defs/shortText"
              },
              "by": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "description": "Where and when the item began: the first year with a firm record."
          },
          "note": {
            "type": "string",
            "minLength": 12,
            "maxLength": 400
          },
          "kind": {
            "enum": [
              "bare",
              "slip",
              "lead",
              "alkaline",
              "tin",
              "ash",
              "feldspathic",
              "salt",
              "crystalline",
              "matte",
              "other"
            ]
          },
          "bodies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "earthenware",
                "stoneware",
                "porcelain",
                "frit"
              ]
            },
            "description": "The kinds of body that the glaze suits."
          }
        }
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "note"
        ],
        "properties": {
          "id": {
            "$ref": "core.schema.json#/$defs/slug"
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "place"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": -30000,
                "maximum": 2100
              },
              "circa": {
                "type": "boolean"
              },
              "place": {
                "$ref": "core.schema.json#/$defs/shortText"
              },
              "by": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              }
            },
            "description": "Where and when the item began: the first year with a firm record."
          },
          "note": {
            "type": "string",
            "minLength": 12,
            "maxLength": 400
          },
          "kind": {
            "enum": [
              "none",
              "painted",
              "printed",
              "relief",
              "incised",
              "inlaid",
              "applied",
              "metallic",
              "marbled",
              "repair"
            ]
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "branch",
          "name"
        ],
        "properties": {
          "id": {
            "$ref": "core.schema.json#/$defs/slug"
          },
          "branch": {
            "enum": [
              "tableware",
              "teaware",
              "kitchen-and-storage",
              "vessels",
              "figurative",
              "tiles",
              "architectural",
              "sanitary-technical"
            ]
          },
          "name": {
            "$ref": "core.schema.json#/$defs/shortText"
          }
        }
      }
    }
  }
}
