{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-ontology.dev/schema/evokes.schema.json",
  "title": "Evokes edges",
  "description": "The emotions that one set of carriers evokes, with evidence. One file per domain for styles (data/evokes/<domain>.json). An edge with only inferred evidence is a guess that a later pass replaces with a source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "carrier",
    "domain",
    "edges"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "carrier": {
      "enum": [
        "style",
        "technique",
        "principle",
        "object",
        "material",
        "moment"
      ]
    },
    "domain": {
      "oneOf": [
        {
          "$ref": "core.schema.json#/$defs/slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "edges": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "emotion",
            "strength",
            "evidence"
          ],
          "properties": {
            "emotion": {
              "$ref": "core.schema.json#/$defs/slug"
            },
            "strength": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Relative inside the carrier: the main emotion is 1."
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "measured",
                      "stated",
                      "inferred"
                    ],
                    "description": "measured: a study with participants. stated: an open source says it. inferred: read from our own data, no outside source."
                  },
                  "claim": {
                    "$ref": "core.schema.json#/$defs/sentence",
                    "description": "What the source says, in our own words."
                  },
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "title"
                    ],
                    "properties": {
                      "title": {
                        "$ref": "core.schema.json#/$defs/sentence"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https?://"
                      }
                    }
                  },
                  "basis": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    },
                    "description": "For inferred: what the guess rests on, as keyword:<word> or cue:<id>."
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "inferred"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "basis"
                      ]
                    },
                    "else": {
                      "required": [
                        "claim",
                        "source"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emotion",
        "strength",
        "evidence"
      ],
      "properties": {
        "emotion": {
          "$ref": "core.schema.json#/$defs/slug"
        },
        "strength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Relative inside the carrier: the main emotion is 1."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "stated",
                  "inferred"
                ],
                "description": "measured: a study with participants. stated: an open source says it. inferred: read from our own data, no outside source."
              },
              "claim": {
                "$ref": "core.schema.json#/$defs/sentence",
                "description": "What the source says, in our own words."
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "$ref": "core.schema.json#/$defs/sentence"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://"
                  }
                }
              },
              "basis": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                },
                "description": "For inferred: what the guess rests on, as keyword:<word> or cue:<id>."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "inferred"
                    }
                  }
                },
                "then": {
                  "required": [
                    "basis"
                  ]
                },
                "else": {
                  "required": [
                    "claim",
                    "source"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
